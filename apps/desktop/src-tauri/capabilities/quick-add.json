{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-add",
  "description": "Minimal capability for the always-on-top quick-add composer window",
  "windows": ["quick-add"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "allow-get-startup-error",
    "allow-set-local-offset",
    "allow-get-quick-add-config",
    "allow-remember-quick-add-target",
    "allow-hide-quick-add",
    "allow-list-notetypes",
    "allow-list-decks",
    "allow-list-tags",
    "allow-get-notetype",
    "allow-check-duplicate",
    "allow-add-note",
    "allow-save-media"
  ]
}
