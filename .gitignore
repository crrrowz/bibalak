# Rust / Cargo (workspace target at repo root)
/target
**/*.rs.bk

# Node
node_modules/
.pnpm-store/

# Frontend build output
apps/*/dist/
dist/

# Tauri generated
apps/*/src-tauri/gen/
apps/*/src-tauri/permissions/autogenerated/
apps/desktop/src-tauri/tauri.site.conf.json

# Test / coverage
coverage/
playwright-report/
test-results/

# Editor / OS
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json

# Local scratch (never commit user data here). Note: test fixtures under
# /fixtures ARE committed (round-trip gate needs real .apkg/.colpkg samples).
/scratch/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Graft architecture cache
graft/

# Signing secrets: never commit (never commit signing secrets)
.keepsake-signing/
*.key
!*.key.pub
updater.password
*.pfx
*.p12
.env
.env.*

# Shell history written by an agent profile
PowerShellHistory.txt

# Local shell history saved in the repo folder by mistake
PowerShellHistory.txt
